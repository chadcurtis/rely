# OpenSearch Configuration
# For Docker Compose (with security disabled):
OPENSEARCH_ADDRESSES=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=nostr-events
OPENSEARCH_INSECURE_SKIP_VERIFY=false

# For production OpenSearch (with security enabled):
# OPENSEARCH_ADDRESSES=https://localhost:9200
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=Admin123!
# OPENSEARCH_INSECURE_SKIP_VERIFY=true

# For clustered OpenSearch:
# OPENSEARCH_ADDRESSES=https://node1:9200,https://node2:9200,https://node3:9200

# Relay Configuration
RELAY_HOST=localhost
RELAY_PORT=3334
RELAY_DOMAIN=example.com
